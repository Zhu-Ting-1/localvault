<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <runtime>
    <!-- 这是一个低吞吐的常驻小服务：关掉后台并发 GC，
         省掉 GC 线程与部分堆开销（代价是回收时停顿稍长，对本场景无感）。 -->
    <gcServer enabled="false"/>
    <gcConcurrent enabled="false"/>
  </runtime>
</configuration>
