# 换行符：源码统一 LF；PowerShell 脚本保持 CRLF + BOM（Windows PowerShell 5.1 验证过的组合）
* text=auto eol=lf

# PowerShell / CMD 需要 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 源码与文档
*.cs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# 二进制：不做换行转换，不参与文本 diff
*.png binary
*.ico binary
*.exe binary
*.zip binary
